{
  "name": "matlab-viz",
  "displayName": "MATLAB Viz",
  "description": "Interactive MATLAB and Simulink dependency graphs powered by MATLAB's native dependency analysis.",
  "version": "0.3.21",
  "publisher": "daw-0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DAW-0/matlab-viz.git"
  },
  "homepage": "https://github.com/DAW-0/matlab-viz#readme",
  "bugs": {
    "url": "https://github.com/DAW-0/matlab-viz/issues"
  },
  "engines": {
    "vscode": "^1.143.0",
    "node": "^22.13.0 || >=24"
  },
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "MATLAB Project analysis can run project-controlled startup/shutdown tasks. Trust the workspace before using MATLAB Viz." },
    "virtualWorkspaces": { "supported": false, "description": "This development build is validated only with a local Windows filesystem and a local MATLAB installation." }
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "MATLAB",
    "Simulink",
    "dependency graph",
    "impact analysis",
    "call graph",
    "code visualization"
  ],
  "activationEvents": [
    "onWebviewPanel:matlabViz.graph",
    "onView:matlabViz.sidebar",
    "onCommand:matlabViz.analyzeWorkspace",
    "onCommand:matlabViz.analyzeSelection",
    "onCommand:matlabViz.refresh",
    "onCommand:matlabViz.showGraph",
    "onCommand:matlabViz.exportGraph",
    "onCommand:matlabViz.openLogs",
    "onCommand:matlabViz.showCallHierarchy",
    "onCommand:matlabViz.showCallers",
    "onCommand:matlabViz.showCallees",
    "onCommand:matlabViz.traceSymbolReferences"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "matlabViz.analyzeWorkspace",
        "title": "MATLAB Viz: Analyze Workspace"
      },
      {
        "command": "matlabViz.analyzeSelection",
        "title": "MATLAB Viz: Analyze Selected File or Folder"
      },
      {
        "command": "matlabViz.refresh",
        "title": "MATLAB Viz: Refresh Dependency Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "matlabViz.showGraph",
        "title": "MATLAB Viz: Show Dependency Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "matlabViz.exportGraph",
        "title": "MATLAB Viz: Export Graph"
      },
      {
        "command": "matlabViz.openLogs",
        "title": "MATLAB Viz: Show Logs"
      },
      {
        "command": "matlabViz.configureMatlab",
        "title": "MATLAB Viz: Configure MATLAB Executable"
      },
      {
        "command": "matlabViz.showCallHierarchy",
        "title": "MATLAB Viz: Show Function Call Hierarchy"
      },
      {
        "command": "matlabViz.showCallers",
        "title": "MATLAB Viz: Show Callers"
      },
      {
        "command": "matlabViz.showCallees",
        "title": "MATLAB Viz: Show Callees"
      },
      {
        "command": "matlabViz.traceSymbolReferences",
        "title": "MATLAB Viz: Trace Symbol References"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "matlabViz.analyzeSelection",
          "group": "navigation@90",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "matlabViz.showCallHierarchy",
          "group": "navigation@90",
          "when": "resourceExtname == .m"
        },
        {
          "command": "matlabViz.showCallers",
          "group": "navigation@91",
          "when": "resourceExtname == .m"
        },
        {
          "command": "matlabViz.showCallees",
          "group": "navigation@92",
          "when": "resourceExtname == .m"
        },
        {
          "command": "matlabViz.traceSymbolReferences",
          "group": "navigation@93",
          "when": "resourceExtname == .m"
        }
      ],
      "view/title": [
        {
          "command": "matlabViz.refresh",
          "group": "navigation",
          "when": "view == matlabViz.sidebar"
        },
        {
          "command": "matlabViz.showGraph",
          "group": "navigation@2",
          "when": "view == matlabViz.sidebar"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "matlabViz",
          "title": "MATLAB Viz",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "matlabViz": [
        {
          "id": "matlabViz.sidebar",
          "name": "Dependency Graph",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "MATLAB Viz",
      "properties": {
        "matlabViz.matlabExecutable": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the MATLAB executable. Leave blank to auto-detect MATLAB."
        },
        "matlabViz.analysisMode": {
          "type": "string",
          "enum": [
            "auto",
            "project",
            "folder"
          ],
          "enumDescriptions": [
            "Use MATLAB Project dependencies when a project is detected, otherwise analyze files.",
            "Require and use MATLAB's Project Dependency Analyzer graph.",
            "Analyze direct file dependencies with requiredFilesAndProducts."
          ],
          "default": "auto",
          "description": "Dependency-analysis backend."
        },
        "matlabViz.includeExternal": {
          "type": "boolean",
          "default": false,
          "description": "Include dependencies outside the analyzed root."
        },
        "matlabViz.folder.useWorkspacePath": {
          "type": "boolean",
          "default": true,
          "description": "For folder analysis, use the containing workspace folder and its subfolders to resolve dependencies. This does not expand the selected analysis root or enable external-node display."
        },
        "matlabViz.folder.additionalSearchRoots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": [],
          "description": "Additional recursive MATLAB lookup roots for folder analysis. Relative paths are resolved against the containing workspace, or the analysis root outside a workspace. The selected root takes precedence; these roots do not add analyzed source files."
        },
        "matlabViz.includeIsolated": {
          "type": "boolean",
          "default": true,
          "description": "Include files with no detected in-scope dependencies."
        },
        "matlabViz.watchFiles": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh the graph after supported files change."
        },
        "matlabViz.project.reanalyzeAll": {
          "type": "boolean",
          "default": false,
          "description": "Force a complete MATLAB Project dependency reanalysis instead of an incremental update."
        },
        "matlabViz.project.analyzeReferences": {
          "type": "boolean",
          "default": true,
          "description": "Analyze dependencies inside referenced MATLAB Projects."
        },
        "matlabViz.project.analyzeAddOns": {
          "type": "boolean",
          "default": false,
          "description": "Analyze dependencies inside installed add-ons. This can be slow."
        },
        "matlabViz.project.analyzeModelParameters": {
          "type": "boolean",
          "default": false,
          "description": "Analyze dependencies introduced by MATLAB code in Simulink model parameters."
        },
        "matlabViz.defaultLayout": {
          "type": "string",
          "enum": [
            "force",
            "hierarchical",
            "circle",
            "grid"
          ],
          "default": "force",
          "description": "Initial graph layout."
        },
        "matlabViz.maximumFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000,
          "default": 5000,
          "description": "Maximum number of files accepted in one analysis."
        },
        "matlabViz.symbols.maximumDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3,
          "description": "Maximum caller/callee traversal depth for function call-hierarchy graphs."
        },
        "matlabViz.symbols.maximumNodes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 5000,
          "default": 250,
          "description": "Maximum number of nodes in a function or symbol graph."
        },
        "matlabViz.symbols.requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 20,
          "description": "Maximum time to wait for one MATLAB language-service request before continuing with a warning."
        },
        "matlabViz.symbols.analysisTimeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 180,
          "description": "Maximum total time for one function or symbol analysis."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --test \"dist-test/test/*.test.js\"",
    "test:compile": "tsc -p tsconfig.test.json",
    "package": "npm run check && npm run build && vsce package",
    "package:release": "node scripts/packageRelease.mjs",
    "package:check": "node scripts/checkPackage.mjs",
    "vscode:prepublish": "npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.95.0",
    "@eslint/js": "10.0.1",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.0",
    "minimatch@10.2.6": "11.0.1"
  }
}
